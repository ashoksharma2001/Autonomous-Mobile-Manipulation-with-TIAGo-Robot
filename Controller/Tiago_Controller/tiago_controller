from controller import Supervisor
import numpy as np
from scipy import signal
from datetime import datetime
from matplotlib import pyplot as plt

class TiagoController:
    """
    High-level controller for the TIAGo robot in Webots.

    This class drives the base (differential wheels) and the manipulator
    (arm, torso and gripper), reads the onboard sensors, and builds a simple
    LIDAR-based occupancy map while the robot moves around.

    Attributes:
        robot (Supervisor): Webots supervisor handle for the robot.
        timestep (int): Simulation step length in ms.
        MAX_SPEED (float): Upper limit for wheel angular velocity.
        KP (float): Proportional gain used by the control laws.
        KA (float): Secondary gain used by the control laws.
        WHEEL_RADIUS (float): Wheel radius in meters.
        AXLE_LENGTH (float): Wheel-to-wheel distance in meters.
        robot_init_joints (dict): Default joint targets for arm, torso, gripper and head.
        MAX_GRIP_FORCE (float): Force limit applied to the gripper.
        motor_handles (dict): Joint name -> Webots motor device.
        map (np.ndarray): Occupancy grid built from LIDAR hits.
        trajectory_map (np.ndarray): Grid recording where the robot has driven.
        kernel (np.ndarray): Kernel intended for map post-processing.
        angles (np.ndarray): Beam angles matching each LIDAR range reading.
    """

    def __init__(self):
        """
        Sets up the robot, registers all devices (motors, sensors, display),
        and allocates the mapping and trajectory buffers.
        """
        # Create the supervisor and read the world's step size
        self.robot = Supervisor()
        self.timestep = int(self.robot.getBasicTimeStep())
                
        # Motion parameters
        self.MAX_SPEED = 6.28
        self.KP = 1.0
        self.KA = 5.0
        self.WHEEL_RADIUS = 0.10
        self.AXLE_LENGTH = 0.455
        
        # Default joint targets (comments describe the axis each joint rotates about)
        self.robot_init_joints = {
            'torso_lift_joint': 0.35,            # torso height, vertical (z) axis
            'arm_1_joint': 0.71,                 # shoulder rotation about z (lower limit 0.07 rad)
            'arm_2_joint': 1.02,                 # shoulder rotation about x (upper limit 1.02 rad)
            'arm_3_joint': -2.815,               # shoulder rotation about y
            'arm_4_joint': 1.011,                # elbow bend about x
            'arm_5_joint': 0,                    # elbow twist about z
            'arm_6_joint': 0,                    # wrist tilt about y
            'arm_7_joint': 0,                    # wrist roll about x
            'gripper_left_finger_joint': 0,      # left gripper finger
            'gripper_right_finger_joint': 0,     # right gripper finger
            'head_1_joint': 0,                   # head pan (left/right), z axis
            'head_2_joint': 0                    # head tilt (up/down), y axis
        }
                        
        self.MAX_GRIP_FORCE = 10.0  # Gripper force cap
        
        # Register motors and sensors
        self.init_devices()
        
        # Buffers for mapping
        self.map = np.zeros((250, 300))
        self.trajectory_map = np.zeros((250, 300))
        self.kernel = np.ones((20, 20))
        self.angles = np.linspace(2.094395, -2.094395, 667)

    def init_devices(self):
        """
        Looks up every device the controller needs: joint motors, wheel motors,
        GPS, compass, LIDAR and the display. Also turns on joint encoders and
        force feedback on the gripper fingers.
        """
        # Joint motors (arm, torso, gripper, head)
        self.motor_handles = {}
        for joint_name in self.robot_init_joints.keys():
            self.motor_handles[joint_name] = self.robot.getDevice(joint_name)
            
        # Wheel motors run in velocity mode (infinite target position)
        self.leftMotor = self.robot.getDevice('wheel_left_joint')
        self.rightMotor = self.robot.getDevice('wheel_right_joint')
        self.leftMotor.setPosition(float('inf'))
        self.rightMotor.setPosition(float('inf'))
        
        # Localization / perception devices
        self.gps = self.robot.getDevice('gps')
        self.compass = self.robot.getDevice('compass')
        self.lidar = self.robot.getDevice('Hokuyo URG-04LX-UG01')
        self.display = self.robot.getDevice('display')
        
        # Start the sensors
        self.gps.enable(self.timestep)
        self.compass.enable(self.timestep)
        self.lidar.enable(self.timestep)
        self.lidar.enablePointCloud()
               
        # Handle to the visual waypoint marker in the world
        self.marker = self.robot.getFromDef("marker").getField("translation")
        
        # Initial pen color for the display
        self.display.setColor(0xFF0000)

        # Joint position sensors
        self.encoders = {}  # start from a clean dictionary
        for joint_name in self.robot_init_joints.keys():
            try:
                if 'gripper' in joint_name:
                    # Gripper sensors follow a different naming pattern
                    sensor_name = joint_name.replace('gripper_', 'gripper_').replace('finger_joint', 'sensor_finger_joint')
                else:
                    sensor_name = joint_name + '_sensor'
                
                encoder = self.robot.getDevice(sensor_name)
                if encoder is not None:
                    encoder.enable(self.timestep)
                    self.encoders[joint_name] = encoder
                else:
                    print(f"Warning: Encoder '{sensor_name}' not found")
            except Exception as e:
                print(f"Error initializing {joint_name}: {e}")

        # Gripper force readings
        self.motor_handles['gripper_left_finger_joint'].enableForceFeedback(self.timestep)
        self.motor_handles['gripper_right_finger_joint'].enableForceFeedback(self.timestep)

    def control_wheel(self, action=None, waypoints=None):
        """
        Drives the base through a list of waypoints, one after another.

        Args:
            action (str, optional): Label used in log output.
            waypoints (list of tuples, optional): (x, y) targets in world coordinates.

        Raises:
            ValueError: If the waypoint list is empty or missing.
            RuntimeError: If anything goes wrong while driving.

        Returns:
            bool: True once the last waypoint is reached.
        """
        if not waypoints:
            raise ValueError("No waypoints provided")
        
        try:
            index = 0
            while self.robot.step(self.timestep) != -1:
                # Read pose from GPS and compass
                gps_values = self.gps.getValues()
                compass_values = self.compass.getValues()
                xw, yw = gps_values[0], gps_values[1]
                theta = np.arctan2(compass_values[0], compass_values[1])
                
                # Move the visual marker onto the current target
                self.marker.setSFVec3f([*waypoints[index], 0])
                
                # Distance (rho) and heading error (alpha) to the target
                rho = np.sqrt((xw - waypoints[index][0])**2 + 
                             (yw - waypoints[index][1])**2)
                alpha = np.arctan2(waypoints[index][1] - yw, 
                                 waypoints[index][0] - xw) - theta
                
                # Wrap the heading error into [-pi, pi]
                if alpha > np.pi: alpha -= 2 * np.pi
                elif alpha < -np.pi: alpha += 2 * np.pi
                
                # Convert the errors into wheel speeds
                left_speed, right_speed = self.calculate_motor_speeds(alpha, rho)
                
                # Close enough? Advance to the next waypoint (or finish)
                if rho < 0.5:
                    self.print_debug(f"  > Reached waypoint '{index}', position: {waypoints[index]}")
                    index += 1
                    if index == len(waypoints):
                        self.leftMotor.setVelocity(0)
                        self.rightMotor.setVelocity(0)
                        self.print_debug(f"Wheel action '{action}' completed")
                        return True
                
                # Apply the wheel speeds
                self.leftMotor.setVelocity(left_speed)
                self.rightMotor.setVelocity(right_speed)
                
                # Fold the latest LIDAR scan into the map
                self.update_mapping(xw, yw, theta)
                
                # Mark the robot's current cell and redraw the path on the display
                px, py = self.world2map(xw, yw)
                self.trajectory_map[px, py] = 1.0
                self.display.setColor(0xFF0000)
                for i in range(250):
                    for j in range(300):
                        if self.trajectory_map[i, j] > 0:
                            self.display.drawPixel(i, j)
        
        except Exception as e:
            # Halt the base if something fails
            self.leftMotor.setVelocity(0)
            self.rightMotor.setVelocity(0)
            raise RuntimeError(f"Wheel control failed during '{action}': {str(e)}")

    def control_arm(self, action=None, positions=None, tolerance=0.005):
        """
        Commands a set of joints to target angles and blocks until they get
        there (within tolerance) or the step budget runs out.

        Args:
            action (str, optional): Label used in log output.
            positions (dict, optional): Joint name -> target angle (rad). Defaults to the home pose.
            tolerance (float, optional): Allowed joint error in radians.

        Raises:
            ValueError: If a joint name is not recognized.
            RuntimeError: If the move fails or takes too long.

        Returns:
            bool: True when every joint has reached its target.
        """
        if not positions:
            positions = self.robot_init_joints
        
        try:
            # Check each joint name and send its target
            for joint_name, target_position in positions.items():
                if joint_name not in self.motor_handles:
                    raise ValueError(f"Invalid joint name: {joint_name}")
                self.motor_handles[joint_name].setPosition(target_position)

            # Step the simulation until all joints settle
            timeout_steps = 1000  # safety limit against endless loops
            steps = 0
            
            while self.robot.step(self.timestep) != -1:
                steps += 1
                if steps > timeout_steps:
                    raise RuntimeError("Movement timeout exceeded")
                
                all_reached = True
                for joint_name, target_position in positions.items():
                    if joint_name in self.encoders:
                        current_pos = self.encoders[joint_name].getValue()
                        if abs(current_pos - target_position) > tolerance:
                            all_reached = False
                            break
                
                if all_reached:
                    self.print_debug(f"Arm action '{action}' completed")
                    return True
                
        except Exception as e:
            raise RuntimeError(f"Arm control failed during '{action}': {str(e)}")

    def world2map(self, xw, yw):
        """
        Maps a world-frame point to a cell in the occupancy grid.

        Args:
            xw (float): World X coordinate.
            yw (float): World Y coordinate.

        Returns:
            list: [px, py] grid indices, limited to the grid's bounds.
        """
        px = int(52 * xw + 124.8)
        py = int(-52 * yw + 93.834)
        px = max(min(px, 249), 0)
        py = max(min(py, 299), 0)
        return [px, py]

    def calculate_motor_speeds(self, alpha, rho):
        """
        Turns heading and distance errors into left/right wheel speeds.
        When the heading error is large, the robot mostly rotates in place.

        Args:
            alpha (float): Heading error in radians.
            rho (float): Distance to target in meters.

        Returns:
            tuple: (left_speed, right_speed) in rad/s, limited to +/-MAX_SPEED.
        """
        p1, p2 = 2.8, 2.6
        if abs(alpha) > np.pi/4:
            leftSpeed = -alpha * p1 / 2 + rho * p2 / 8
            rightSpeed = alpha * p1 / 2 + rho * p2 / 8
        else:
            leftSpeed = -alpha * p1 + rho * p2
            rightSpeed = alpha * p1 + rho * p2
            
        # Saturate to the speed limit
        leftSpeed = max(min(leftSpeed, self.MAX_SPEED), -self.MAX_SPEED)
        rightSpeed = max(min(rightSpeed, self.MAX_SPEED), -self.MAX_SPEED)
        return leftSpeed, rightSpeed

    def update_mapping(self, xw, yw, theta):
        """
        Projects the current LIDAR scan into the world frame and raises the
        occupancy value of every cell that was hit.

        Args:
            xw (float): Robot X in the world frame.
            yw (float): Robot Y in the world frame.
            theta (float): Robot heading in radians.
        """
        ranges = np.array(self.lidar.getRangeImage())
        ranges[ranges == np.inf] = 100  # stand-in value for "no return"
        
        # Drop the outermost beams on both sides
        valid_ranges = ranges[80:-80]
        valid_angles = self.angles[80:-80]
        
        # Polar -> Cartesian in the robot's own frame (homogeneous coordinates)
        X_r = np.array([
            (valid_ranges * np.cos(valid_angles)),
            (valid_ranges * np.sin(valid_angles)),
            np.ones(len(valid_angles))
        ])
        
        # Rigid transform: robot frame -> world frame
        w_T_r = np.array([
            [np.cos(theta), -np.sin(theta), xw],
            [np.sin(theta), np.cos(theta), yw],
            [0, 0, 1]
        ])
        D = w_T_r @ X_r
        
        # Raise occupancy for each hit cell and paint it in grayscale
        for i in range(D.shape[1]):
            px, py = self.world2map(D[0, i], D[1, i])
            self.map[px, py] = min(self.map[px, py] + 0.01, 1.0)
            color_byte = int(self.map[px, py] * 255)
            color = (color_byte << 16) | (color_byte << 8) | color_byte
            self.display.setColor(color)
            self.display.drawPixel(px, py)

    def grab_object(self, action_id):
        """
        Picks up an object: reach out, close the fingers, then raise the arm.

        Args:
            action_id (int): Index of this pick, used in log labels.

        Raises:
            RuntimeError: If any stage of the pick fails.

        Returns:
            bool: True if the whole sequence finishes.
        """
        try:
            # Stage 1: extend the arm out horizontally
            if not self.control_arm(f"grab-{action_id}a", {
                'arm_2_joint': 0,
                'arm_4_joint': 0,
                'arm_5_joint': 1.571,
            }):
                raise RuntimeError("Failed to position arm horizontally")
                
            self.wait_for_milliseconds(300)
            
            # Stage 2: close the fingers around the object
            if not self.control_arm(f"grab-{action_id}b", {
                'gripper_left_finger_joint': 0.04,
                'gripper_right_finger_joint': 0.04,
            }):
                raise RuntimeError("Failed to close gripper")
                
            self.wait_for_milliseconds(300)
            
            # Stage 3: raise the arm while holding the object
            if not self.control_arm(f"grab-{action_id}c", {
                'arm_2_joint': 1.000,
                'arm_4_joint': -0.262,
                'arm_5_joint': 1.571,
            }):
                raise RuntimeError("Failed to lift arm")
                
            self.wait_for_milliseconds(300)
            return True
            
        except Exception as e:
            raise RuntimeError(f"Grab object sequence {action_id} failed: {str(e)}")

    def drop_object(self, action_id):
        """
        Releases the held object: lower the torso, open the fingers, then
        bring the arm back up.

        Args:
            action_id (int): Index of this drop, used in log labels.

        Raises:
            RuntimeError: If any stage of the drop fails.

        Returns:
            bool: True if the whole sequence finishes.
        """
        try:
            # Stage 1: lower the torso and tilt the wrist toward the drop spot
            if not self.control_arm(f"drop-{action_id}d", {
                'torso_lift_joint': 0.10,
                'arm_2_joint': 0,
                'arm_6_joint': -0.524,
            }):
                raise RuntimeError("Failed to position arm for drop")
                
            self.wait_for_milliseconds(300)
            
            # Stage 2: open the fingers to let go
            if not self.control_arm(f"drop-{action_id}b", {
                'gripper_left_finger_joint': 0.07,
                'gripper_right_finger_joint': 0.07,
            }):
                raise RuntimeError("Failed to open gripper")
                
            self.wait_for_milliseconds(300)
            
            # Stage 3: raise the torso and arm back to the carrying pose
            if not self.control_arm(f"drop-{action_id}c", {
                'torso_lift_joint': 0.28,
                'arm_2_joint': 1.000,
                'arm_6_joint': 0,
            }):
                raise RuntimeError("Failed to return to upright position")
                
            self.wait_for_milliseconds(300)
            return True
            
        except Exception as e:
            raise RuntimeError(f"Drop object sequence {action_id} failed: {str(e)}")

    def wait_for_milliseconds(self, milliseconds):
        """
        Idles for the given time by stepping the simulation.

        Args:
            milliseconds (int): How long to wait, in ms.
        """
        loop = int(milliseconds / self.timestep)
        for _ in range(loop):
            self.robot.step(self.timestep)

    def print_debug(self, message):
        """
        Prints a message prefixed with a millisecond-resolution timestamp.

        Args:
            message (str): Text to print.
        """
        # Timestamp trimmed from microseconds to milliseconds
        formatted_time = datetime.now().strftime('%Y%m%d %H%M%S.%f')[:-3]
        print(f"{formatted_time}\t{message}")

    def run(self):
        """
        Main mission routine: put the arm in its carrying pose, drive to the
        pickup area, then repeat grab -> deliver -> drop -> return three times.

        Raises:
            RuntimeError: If a step in the mission fails (caught internally).

        Returns:
            bool: True if the mission finishes, False if it aborts.
        """
        try:
            # -----------------------------------------------------------------------
            # Startup: carrying pose and first approach
            # -----------------------------------------------------------------------
            if not self.control_arm('arm-initial', {
                'torso_lift_joint': 0.28,
                'arm_1_joint': 1.571,
                'arm_2_joint': 1.000,
                'arm_4_joint': -0.262,
                'arm_5_joint': 1.571,
                'gripper_left_finger_joint': 0.07,
                'gripper_right_finger_joint': 0.07,
            }):
                raise RuntimeError("Failed to set initial arm position")

            if not self.control_wheel('navigation-initial', [(0.960, 0.500)]):
                raise RuntimeError("Failed initial navigation")

            # Per-round offsets so the objects at the kitchen end up in different spots
            finetune_waypoints = {
                1: [
                    ( 0.000, -0.700),
                    ( 0.960,  0.300)
                ],
                2: [
                    ( 0.000, -0.900),
                    ( 0.960,  0.100),
                ],
                3: [
                    ( 0.000, -1.100),
                    (-1.727,  0.968),
                ],
            }
            
            # -----------------------------------------------------------------------
            # Three rounds: pick up, carry over, drop off, drive back
            # -----------------------------------------------------------------------
            for round_num in range(1, 4):
                # Pick up the object
                if not self.grab_object(round_num):
                    raise RuntimeError(f"Failed to grab object in round {round_num}")
                
                # Carry it to the drop-off point
                if not self.control_wheel(f'navigation-{round_num}a', [
                    (1.025, -0.326),
                    finetune_waypoints[round_num][0]
                ]):
                    raise RuntimeError(f"Failed navigation {round_num}a")
                
                # Put it down
                if not self.drop_object(round_num):
                    raise RuntimeError(f"Failed to drop object in round {round_num}")
                
                # Loop around the room back to the pickup area
                if not self.control_wheel(f'navigation-{round_num}b', [
                    ( 0.550, -2.500),  # right side
                    ( 0.550, -3.100),  # lower right
                    (-0.682, -3.500),  # bottom
                    (-1.550, -2.800),  # lower left
                    (-1.550, -1.500),  # left side
                    (-1.550, -0.000),  # upper left
                    finetune_waypoints[round_num][1]
                ]):
                    raise RuntimeError(f"Failed navigation {round_num}b")

            self.print_debug("Mission completed successfully")
            return True

        except Exception as e:
            self.print_debug(f"Mission failed: {str(e)}")
            # Stop the base before giving up
            self.leftMotor.setVelocity(0)
            self.rightMotor.setVelocity(0)
            return False


if __name__ == "__main__":
    """
    Script entry point: build the controller and run the mission.
    """
    # Instantiate and start
    controller = TiagoController()
    controller.run()
